#!/usr/bin/env bash

set -e

# Find all staged .go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    exit 0
fi

echo "==> Checking staged Go files..."

# Format check staged files
UNFORMATTED=$(gofmt -l $STAGED_GO_FILES)
if [ -n "$UNFORMATTED" ]; then
    echo "Error: Staged files need formatting:"
    echo "$UNFORMATTED"
    echo "Run 'gofmt -w <file>' and stage the changes."
    exit 1
fi

go vet ./...
go build -o /dev/null ./...
go test ./...

echo "==> Pre-commit checks passed"
